# ---------- Supabase (Project Settings > API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ---------- Google Drive ----------
# โฟลเดอร์ปลายทางที่จะเก็บรายงาน (ตัวอักษรหลัง /folders/ ใน URL ของโฟลเดอร์)
GOOGLE_DRIVE_FOLDER_ID=

# วิธี A (แนะนำสำหรับ Gmail ส่วนตัว): OAuth refresh token
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# วิธี B: Service Account (ต้องใช้โฟลเดอร์ใน Shared Drive ของ Google Workspace เท่านั้น)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
